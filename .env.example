# Copy to .env (git-ignored) to switch the Campaign Assistant to AI mode.
# Leave every key empty (or delete .env) to use the basic rules-based mode.

# --- OpenAI, or any OpenAI-compatible endpoint (e.g. a company gateway)
OPENAI_API_KEY=
OPENAI_BASE_URL=          # leave empty for api.openai.com; otherwise your endpoint, usually ending in /v1
OPENAI_MODEL=gpt-5.2      # the model (or deployment) name your endpoint expects

# --- Anthropic (optional)
ANTHROPIC_API_KEY=

# --- Which one to use when both keys are set: openai | anthropic | basic
LLM_PROVIDER=
